---
import Logo from './Logo.astro';
import { CITY_LINE, FOOTER_GROUPS, SITE, url } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div class="brand stack">
      <Logo width={116} />
      <p class="muted">{SITE.tagline}</p>
      <address class="muted">
        {SITE.address.street}<br />
        {CITY_LINE}
      </address>
    </div>
    {
      FOOTER_GROUPS.map((group) => (
        <div>
          <h2 class="group-title">{group.title}</h2>
          <ul>
            {group.links.map((l) => (
              <li>
                <a href={url(l.href)}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="container legal">
    <p>&copy; {year} {SITE.legalName}</p>
    <div class="legal-links">
      {SITE.umamiId && <button type="button" class="linkish" data-consent-open>Cookie settings</button>}
      <a href={url('/privacy/')}>Privacy</a>
      <a href={url('/terms/')}>Terms</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section);
    padding-block: var(--s5) var(--s4);
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
  }
  .grid {
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .brand {
    grid-column: 1 / -1;
  }
  address {
    font-style: normal;
  }
  .group-title {
    margin-bottom: var(--s1);
    font-family: var(--font);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
  }
  ul {
    list-style: none;
    display: grid;
    gap: 0.15rem;
  }
  .grid a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: var(--muted);
    text-decoration: none;
  }
  .grid a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s2);
    margin-top: var(--s4);
    padding-top: var(--s3);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--step--1);
  }
  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }
  .legal-links a,
  .linkish {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .legal-links a:hover,
  .linkish:hover {
    color: var(--text);
    text-decoration: underline;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.7fr repeat(3, 1fr);
    }
    .brand {
      grid-column: auto;
    }
  }
</style>
