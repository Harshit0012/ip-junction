---
// Redrawn from the deck's raster logo. Replace with the original vector when available.
interface Props {
  width?: number;
}
const { width = 132 } = Astro.props;
---

<svg
  class="logo"
  viewBox="0 0 200 80"
  width={width}
  height={Math.round((width * 80) / 200)}
  role="img"
  aria-label="IPJunction"
>
  <rect x="56" y="24" width="142" height="32" rx="3" fill="#173e9e"></rect>
  <circle cx="40" cy="40" r="38" fill="#1f4fbf"></circle>
  <text x="40" y="57" text-anchor="middle" font-size="48" font-weight="700" letter-spacing="-3" fill="#fff">IP</text>
  <text x="137" y="46.5" text-anchor="middle" font-size="17" font-weight="600" letter-spacing="1.2" fill="#fff"
    >JUNCTION</text
  >
</svg>

<style>
  .logo {
    display: block;
    flex: none;
  }
</style>
