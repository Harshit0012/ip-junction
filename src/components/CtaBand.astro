---
import { PRIMARY_CTA, url } from '../data/site';
interface Props {
  title?: string;
  body?: string;
  label?: string;
}
const {
  title = 'A network, cloud or investment decision ahead?',
  body = 'A 30-minute call is enough to tell whether we can help.',
  label = PRIMARY_CTA.label,
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <div class="container inner">
    <div class="stack">
      <h2 id="cta-title">{title}</h2>
      <p>{body}</p>
    </div>
    <a class="btn" href={url(PRIMARY_CTA.href)}>{label}</a>
  </div>
</section>

<style>
  .cta {
    margin-top: var(--section);
    padding-block: var(--s6);
    background: var(--navy);
    color: #fff;
  }
  .inner {
    display: grid;
    gap: var(--s3);
    align-items: center;
  }
  h2 {
    font-size: var(--step-3);
    max-width: 24ch;
  }
  p {
    color: var(--on-navy-muted);
  }
  .btn {
    justify-self: start;
    background: #fff;
    border-color: #fff;
    color: var(--navy);
  }
  .btn:hover {
    background: var(--accent-tint);
    border-color: var(--accent-tint);
  }
  :focus-visible {
    outline-color: #fff;
  }
  @media (min-width: 760px) {
    .inner {
      grid-template-columns: 1fr auto;
      gap: var(--s5);
    }
    .btn {
      justify-self: end;
    }
  }
</style>
