---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import LayerStack from '../components/LayerStack.astro';
import CtaBand from '../components/CtaBand.astro';
import founder from '../assets/founder.jpg';
import { PRIMARY_CTA, SITE, url } from '../data/site';

const capabilities = [
  'Technology strategy',
  'Network and cloud transformation',
  'Systems integration',
  'Operational excellence',
  'Process optimization',
  'Emerging technologies',
] as const;

const stats = [
  ['2009', 'Founded'],
  ['10+', 'Tier-1 clients served'],
  ['20+', 'Strategic engagements'],
  ['5', 'Practice areas'],
] as const;

const posts = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.legalName,
  url: new URL(url('/'), Astro.site).href,
  logo: new URL(url('/favicon.svg'), Astro.site).href,
  slogan: SITE.tagline,
  foundingDate: String(SITE.foundingYear),
  email: SITE.email,
  telephone: SITE.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  founder: { '@type': 'Person', name: SITE.founder.name, jobTitle: SITE.founder.role },
};
---

<Base description={SITE.description} jsonLd={jsonLd}>
  <section class="hero container">
    <div class="copy">
      <div class="lockup">
        <Logo width={240} />
        <p class="tagline">{SITE.tagline}</p>
      </div>
      <h1>Network and cloud strategy, from people who have built it.</h1>
      <p class="lede">Boutique advisory for telecom operators, vendors and investors. Founder-led since 2009.</p>
      <div class="actions">
        <a class="btn" href={url(PRIMARY_CTA.href)}>{PRIMARY_CTA.label}</a>
        <a class="btn btn-ghost" href={url('/offerings/')}>See our work</a>
      </div>
    </div>
    <dl class="stats" aria-label="IPJunction in numbers">
      {
        stats.map(([n, label]) => (
          <div class="stat reveal">
            <dt>{label}</dt>
            <dd>{n}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="band" aria-labelledby="stack-h">
    <div class="container">
      <div class="section-head">
        <h2 id="stack-h">One partner across the network stack.</h2>
        <p class="lede">Traffic crosses five layers. Here is where our work sits.</p>
      </div>
      <LayerStack
        title="IPJunction across the network stack"
        description="Five layers from device to cloud: radio, transport IP/MPLS, core, cloud and edge, and OSS/BSS. Engagements are pinned to the layer they touched: SPO Partners on radio, Vesta and Fujitsu on transport, Verizon and Charter on core."
      />
    </div>
  </section>

  <section class="section container" aria-labelledby="what-we-do">
    <div class="section-head">
      <h2 id="what-we-do">What we do</h2>
    </div>
    <ol class="caps">
      {
        capabilities.map((c, i) => (
          <li class="reveal">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span>{c}</span>
          </li>
        ))
      }
    </ol>
    <p class="more"><a class="link-arrow" href={url('/platform/')}>See the technology</a></p>
  </section>

  <section class="band" aria-labelledby="founder">
    <div class="container founder reveal">
      <Picture
        src={founder}
        width={224}
        height={224}
        fit="cover"
        position="top"
        formats={['avif', 'webp']}
        alt="Deepak Kataria, Founder and Managing Director of IPJunction"
        class="headshot lg"
      />
      <div class="stack">
        <h2 id="founder">Founder-led, on every engagement.</h2>
        <p class="lede">Deepak Kataria: three decades in telecom, and architect on AT&amp;T's Network Cloud and O-RAN.</p>
        <a class="link-arrow" href={url('/about/')}>Meet the founder</a>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="insights">
    <div class="section-head head-row">
      <h2 id="insights">Latest insights</h2>
      <a class="link-arrow" href={url('/insights/')}>All insights</a>
    </div>
    <ol class="posts">
      {
        posts.map((p) => (
          <li class="reveal">
            <a class="card" href={url(`/insights/${p.id}/`)}>
              <h3>{p.data.title}</h3>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--s5);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) 0;
  }
  .copy {
    display: grid;
    gap: var(--s3);
    justify-items: start;
  }
  .lockup {
    display: grid;
    gap: 0.5rem;
  }
  .tagline {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .hero h1 {
    max-width: 19ch;
    font-size: clamp(2.3rem, 1.4rem + 4vw, 4rem);
    line-height: 1.06;
  }
  .hero .lede {
    max-width: 44ch;
  }
  .more {
    margin-top: var(--s3);
  }
  .stats {
    margin: 0;
    display: grid;
    gap: var(--s3) var(--s2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .caps {
    display: grid;
    gap: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }
  .caps li {
    display: flex;
    align-items: baseline;
    gap: var(--s2);
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 600;
  }
  .num {
    min-width: 2ch;
    color: var(--warm);
    font-family: var(--font);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  @media (min-width: 760px) {
    .caps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s5);
    }
  }
  .founder {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s3);
    align-items: center;
  }
  .founder h2 {
    font-size: var(--step-3);
  }
  @media (min-width: 760px) {
    .founder {
      grid-template-columns: auto 1fr;
      gap: var(--s4);
    }
  }
  .head-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
  }
  .posts {
    display: grid;
    gap: var(--s2);
    list-style: none;
  }
  @media (min-width: 760px) {
    .posts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .posts a {
    height: 100%;
    text-decoration: none;
    transition: border-color 160ms ease;
  }
  .posts a:hover {
    border-color: var(--accent-text);
  }
  .posts time {
    color: var(--accent-text);
    font-size: var(--step--1);
    font-weight: 600;
  }
</style>
