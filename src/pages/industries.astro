---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { byIndustry, type Industry } from '../data/engagements';

const industries: { name: Industry; body: string }[] = [
  { name: 'Telecom operators', body: 'Wireless and wireline carriers.' },
  { name: 'Cable operators', body: 'Cable operators and MSOs.' },
  { name: 'Technology vendors', body: 'Equipment and technology vendors.' },
  { name: 'Cloud & enterprise networks', body: 'Distributed data center operators.' },
  { name: 'Private equity', body: 'Investors in networks and spectrum.' },
];
---

<Base title="Industries" description="IPJunction works with telecom operators, cable operators, technology vendors, cloud and enterprise networks, and private equity firms.">
  <PageHead
    kicker="Industries"
    title="Built for the people who run, supply and fund networks."
    lede="We know the network from each side of the table."
  />

  <section class="section container" aria-labelledby="focus-h">
    <div class="section-head">
      <h2 id="focus-h">Who we work with</h2>
    </div>
    <ul class="flows">
      {
        industries.map((ind) => (
          <li class="flow reveal">
            <div class="node">
              <h3>{ind.name}</h3>
              <p>{ind.body}</p>
            </div>
            <span class="wire" aria-hidden="true"><i class="motion-only" /></span>
            <ul class="tags" aria-label={`${ind.name} clients`}>
              {byIndustry(ind.name).map((e) => (
                <li>{e.client}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand title="See how this maps to your environment." label="Talk to us" />
</Base>

<style>
  .flows {
    display: grid;
    gap: var(--s2);
    list-style: none;
  }
  .flow {
    display: grid;
    gap: var(--s1);
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .node h3 {
    font-size: 1.2rem;
  }
  .node p {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .wire {
    position: relative;
    display: block;
    height: 2px;
    overflow: hidden;
    background: var(--border-strong);
  }
  .wire i {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent 44%, var(--accent) 47%, var(--accent) 53%, transparent 56%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .wire i {
      animation: wire-travel 2.4s cubic-bezier(0.45, 0, 0.55, 1) 2;
    }
  }
  @keyframes wire-travel {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(50%);
    }
  }
  @media (min-width: 820px) {
    .flow {
      grid-template-columns: 16rem 1fr minmax(0, 1.4fr);
      align-items: center;
      gap: var(--s3);
    }
  }
</style>
