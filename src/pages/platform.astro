---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import LayerStack from '../components/LayerStack.astro';
import CtaBand from '../components/CtaBand.astro';
import { LAYERS } from '../data/layers';

const description = `Five layers from device to cloud. ${LAYERS.map((l) => `${l.name}: ${l.tags.join(', ')}.`).join(' ')}`;
---

<Base title="Platform" description="The network and cloud technology IPJunction works in, from IP/MPLS and SDN/NFV to Open RAN, IMS, OSS/BSS and edge.">
  <PageHead
    kicker="Platform"
    title="The technology we work in, layer by layer."
    lede="We have designed, deployed and audited these systems ourselves."
  />

  <section class="section container" aria-label="Technology layers">
    <LayerStack
      show="tags"
      title="Technology by network layer"
      description={description}
    />
  </section>

  <CtaBand title="Working through a platform decision?" />
</Base>
