---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Timeline from '../components/Timeline.astro';
import CtaBand from '../components/CtaBand.astro';

const steps = [
  { label: 'Assess', note: 'A clear picture of today’s network and costs.', example: 'IP/MPLS audit, Vesta' },
  { label: 'Decide', note: 'Options modeled over the network’s real life.', example: '10-year SDN/NFV TCO, Verizon' },
  { label: 'Deliver', note: 'Program leadership from procurement to cutover.', example: '27-market migration, Charter' },
  { label: 'Measure', note: 'Results tied back to the original case.' },
];

const principles = [
  ['Senior people', 'The person who scopes the work does the work.'],
  ['Vendor-neutral', 'Recommendations follow evidence, not a product line.'],
  ['Standards-grounded', 'Designs trace to 3GPP, IETF, O-RAN and IEEE work.'],
];
---

<Base title="Approach" description="How IPJunction runs engagements: assess, decide, deliver, measure. Advice that carries through to the cutover plan.">
  <PageHead kicker="Approach" title="Advice you can execute." lede="Most strategy stops at the slide deck. Ours carries through to cutover." />

  <section class="band" aria-labelledby="path-h">
    <div class="container">
      <div class="section-head">
        <h2 id="path-h">Four steps from question to result.</h2>
      </div>
      <Timeline steps={steps} />
    </div>
  </section>

  <section class="section container" aria-labelledby="principles">
    <div class="section-head">
      <h2 id="principles">How we hold ourselves to it</h2>
    </div>
    <div class="grid-3">
      {
        principles.map(([t, d]) => (
          <article class="card reveal">
            <h3>{t}</h3>
            <p>{d}</p>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand title="Want to walk through your decision?" label="Talk to us" />
</Base>
