---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaBand from '../components/CtaBand.astro';

// Track shapes show how each model is scoped; they carry no durations or prices.
const models = [
  {
    badge: 'Model 1',
    name: 'Assessment',
    terms: 'Fixed scope, fixed fee',
    shape: 'one',
    outputs: ['Audit', 'Gap analysis', 'TCO model'],
  },
  {
    badge: 'Model 2',
    name: 'Program support',
    terms: 'Scoped by phase',
    shape: 'phases',
    outputs: ['RFI and RFP', 'Solution design', 'Migration planning'],
  },
  {
    badge: 'Model 3',
    name: 'Research & advisory',
    terms: 'Per deliverable or retainer',
    shape: 'ticks',
    outputs: ['White papers', 'Briefings', 'Due diligence'],
  },
] as const;
---

<Base title="Pricing" description="How IPJunction engagements are scoped and priced: assessments, program support, and research and advisory.">
  <PageHead
    kicker="Pricing"
    title="Scoped to the decision, not the hour."
    lede="Tailored to each engagement, with a written scope and a fixed price or phased plan first."
  />

  <section class="section container" aria-labelledby="models-h">
    <div class="section-head">
      <h2 id="models-h">Three ways to engage</h2>
    </div>
    <div class="grid-3">
      {
        models.map((m) => (
          <article class="card reveal">
            <p><span class="badge">{m.badge}</span></p>
            <h3>{m.name}</h3>
            <p class="terms">{m.terms}</p>
            <div class={`track ${m.shape}`} aria-hidden="true">
              <span class="axis" />
              {m.shape === 'one' && <i class="draw block" />}
              {m.shape === 'phases' && (
                <>
                  <i class="draw block p1" />
                  <i class="draw block p2" />
                  <i class="draw block p3" />
                </>
              )}
              {m.shape === 'ticks' && Array.from({ length: 6 }).map((_, k) => <i class="tick" style={`--k:${k}`} />)}
            </div>
            <ul class="tags">
              {m.outputs.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <CtaBand title="Want pricing for your project?" body="It starts with a 30-minute call." label="Request pricing" />
</Base>

<style>
  .terms {
    color: var(--accent-text);
    font-weight: 600;
  }
  .track {
    position: relative;
    height: 3rem;
    margin-block: var(--s1);
  }
  .axis {
    position: absolute;
    inset: auto 0 0.5rem 0;
    height: 1px;
    background: var(--border-strong);
  }
  .block {
    position: absolute;
    bottom: 0.5rem;
    height: 1.6rem;
    border-radius: 4px;
    background: var(--accent);
  }
  .one .block {
    left: 0;
    width: 42%;
  }
  .p1 {
    left: 0;
    width: 26%;
  }
  .p2 {
    left: 34%;
    width: 30%;
    background: var(--accent-strong);
  }
  .p3 {
    left: 72%;
    width: 28%;
  }
  .tick {
    position: absolute;
    bottom: 0.5rem;
    left: calc(var(--k) * 19%);
    width: 6px;
    height: 1.6rem;
    border-radius: 3px;
    background: var(--accent);
  }
  .tick:nth-child(odd) {
    height: 1.1rem;
  }
</style>
