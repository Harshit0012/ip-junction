---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CoverArt from '../../components/CoverArt.astro';
import { url } from '../../data/site';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const cover = (id: string) => (id.includes('tco') ? 'bars' : id.includes('spectrum') ? 'waves' : 'nodes') as 'bars' | 'waves' | 'nodes';

const talks = [
  ['Opening keynote', 'WWRF 2024'],
  ['Keynotes', 'IEEE ANTS'],
  ['Co-Chair, AI/ML Working Group', 'IEEE Future Networks Initiative'],
  ['10+ conferences, symposia and workshops organized', 'IEEE'],
];
const topics = ['AI/ML', 'Edge computing', 'Open RAN', 'Orchestration', 'Public & private cloud', 'Network automation'];
---

<Base title="Insights" description="Notes on networks, cloud, Open RAN, spectrum and AI from IPJunction's consulting work, plus talks and IEEE events.">
  <PageHead kicker="Insights" title="Notes from inside the work." lede="Notes on networks, cloud and AI from current engagements." />

  <section class="section container" aria-label="Articles">
    {
      posts.length === 0 ? (
        <p class="muted">No articles yet. The first ones are on their way.</p>
      ) : (
        <ol class="posts">
          {posts.map((p) => (
            <li class="reveal">
              <a class="card" href={url(`/insights/${p.id}/`)}>
                <CoverArt kind={cover(p.id)} />
                <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
                <h2 class="h">{p.data.title}</h2>
                <ul class="tags">
                  {p.data.topics.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <section class="section container" aria-labelledby="talks">
    <div class="section-head">
      <h2 id="talks">Talks and events</h2>
      <ul class="tags">{topics.map((t) => <li>{t}</li>)}</ul>
    </div>
    <div class="grid-2">
      {
        talks.map(([what, where]) => (
          <article class="card reveal">
            <h3>{what}</h3>
            <p>{where}</p>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .posts {
    display: grid;
    gap: var(--s2);
    list-style: none;
  }
  @media (min-width: 760px) {
    .posts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .posts a {
    height: 100%;
  }
  .posts a {
    text-decoration: none;
    transition: border-color 160ms ease;
  }
  .posts a:hover {
    border-color: var(--accent-text);
  }
  .posts time {
    color: var(--accent-text);
    font-size: var(--step--1);
    font-weight: 600;
  }
  .h {
    font-size: var(--step-2);
    max-width: 34ch;
  }
</style>
