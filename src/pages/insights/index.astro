---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { url } from '../../data/site';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const talks = [
  ['Opening keynote', 'WWRF 2024'],
  ['Keynotes', 'IEEE ANTS'],
  ['Co-Chair, AI/ML Working Group', 'IEEE Future Networks Initiative'],
  ['10+ conferences, symposia and workshops organized', 'IEEE'],
];
const topics = ['AI/ML', 'Edge computing', 'Open RAN', 'Orchestration', 'Public & private cloud', 'Network automation'];
---

<Base title="Insights" description="Notes on networks, cloud, Open RAN, spectrum and AI from IPJunction's consulting work, plus talks and IEEE events.">
  <PageHead title="Insights" lede="Notes on networks, cloud and AI from inside the work." />

  <section class="container" aria-label="Articles">
    {
      posts.length === 0 ? (
        <p class="muted">No articles yet. The first ones are on their way.</p>
      ) : (
        <ol class="posts">
          {posts.map((p, i) => (
            <li class={i === 0 ? 'lead' : ''}>
              <a href={url(`/insights/${p.id}/`)}>
                <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
                <span class="title">{p.data.title}</span>
                <span class="desc">{p.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <section class="section container split" aria-labelledby="talks">
    <div class="sticky stack">
      <h2 id="talks">Talks and events</h2>
      <p class="muted">Our founder speaks and organizes across the IEEE community. Recent topics:</p>
      <ul class="tags">{topics.map((t) => <li>{t}</li>)}</ul>
    </div>
    <ul class="rule-list">
      {
        talks.map(([what, where]) => (
          <li class="reveal">
            <h3>{what}</h3>
            <p>{where}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .posts {
    list-style: none;
  }
  .posts li {
    border-top: 1px solid var(--border);
  }
  .posts a {
    display: grid;
    gap: var(--s1);
    padding-block: var(--s4);
    text-decoration: none;
  }
  .posts time,
  .desc {
    color: var(--muted);
  }
  .posts time {
    font-size: var(--step--1);
  }
  .title {
    font-size: var(--step-2);
    font-weight: 520;
    letter-spacing: -0.015em;
    line-height: 1.25;
    max-width: 36ch;
  }
  .lead .title {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
  }
  .desc {
    max-width: 60ch;
  }
  .posts a:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
