---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { url } from '../data/site';
---

<Base title="Page not found" description="This page does not exist." noindex>
  <PageHead kicker="404" title="That page is not on this network." lede="The link may be old, or the address may have a typo.">
    <ul class="links">
      <li><a class="btn" href={url('/')}>Go to the homepage</a></li>
      <li><a class="link-arrow" href={url('/insights/')}>Insights</a></li>
      <li><a class="link-arrow" href={url('/contact/')}>Contact</a></li>
    </ul>
  </PageHead>
</Base>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    align-items: center;
    margin-top: var(--s4);
    list-style: none;
  }
</style>
