# All optional. Set as GitHub Actions repository variables for deploys.
# Leave empty and the related feature degrades gracefully (see README).

# Cal.com booking link, e.g. deepak-kataria/30min
PUBLIC_CAL_LINK=
# Web3Forms access key (public by design; it only allows sending to the owner's inbox)
PUBLIC_WEB3FORMS_KEY=
# Umami Cloud website ID. When set, the consent banner appears and analytics load only after Accept.
PUBLIC_UMAMI_ID=
# Set to "true" at launch to allow search indexing. Prototype stays noindex.
PUBLIC_INDEXABLE=
# Custom domain launch: SITE_URL=https://www.ip-junction.com and BASE_PATH=/
SITE_URL=
BASE_PATH=
